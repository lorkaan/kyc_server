[
    {
        "name": "current_alerts",
        "description": "A Query to get all active alerts",
        "query": {
            "model": "watchdog.Alert",
            "params": {
                "before_time": {
                    "type": "datetime",
                    "required": true
                }
            },
            "query":{
                "where":{
                    "and": [
                        {"field": "status__is_terminal", "op": "eq", "value": false},
                        {"field": "created_at", "op": "lt", "value": {"$param": "before_time"}}
                    ]
                }
            }
        },
        "is_system": true
    },
    {
        "name": "Unverified KYC Records",
        "description": "Find a current KYC based on the Party",
        "is_system": true,
        "query": {
            "model": "kyc.KYCRecord",
            "params": {
                "status": {"type": "string", "required": false},
                "created_start_date": { "type": "datetime", "required": false },
                "created_end_date": { "type": "datetime", "required": false },
                "updated_start_date": { "type": "datetime", "required": false },
                "updated_end_date": { "type": "datetime", "required": false },
                "nickname": {"type": "string", "required": false},
                "notes": {"type": "string", "required": false}
            },
            "query": {
                "where": {
                    "and": [
                        {
                            "field": "created_at",
                            "op": "gte",
                            "value": { "$param": "created_start_date" }
                        },
                        {
                            "field": "created_at",
                            "op": "lte",
                            "value": { "$param": "created_end_date" }
                        },
                        {
                            "field": "updated_at",
                            "op": "gte",
                            "value": { "$param": "updated_start_date" }
                        },
                        {
                            "field": "updated_at",
                            "op": "lte",
                            "value": { "$param": "updated_end_date" }
                        },
                        {
                            "field": "status__name",
                            "op": "contains",
                            "value": { "$param": "status" }
                        },
                        {
                            "field": "party__name",
                            "op": "contains",
                            "value": { "$param": "nickname" }
                        },
                        {
                            "field": "notes",
                            "op": "contains",
                            "value": { "$param": "notes" }
                        },
                        {
                            "field": "verified_at",
                            "op": "isnull",
                            "value": true
                        },
                        {
                            "field": "status__code",
                            "op": "neq",
                            "value": "rejected"
                        }
                    ]
                }
            },
            "fields": [
                {
                    "path": "party__name",
                    "name": "NickName"
                },
                {
                    "path": "status__name",
                    "name": "Status"
                },
                {
                    "path": "party.target.name",
                    "name": "Name"
                }
            ],
            "default_fields": [
                "Name",
                "NickName",
                "Status",
                "notes",
                "is_current",
                "created_at",
                "updated_at",
                "verified_at"
            ]
        }
    },
